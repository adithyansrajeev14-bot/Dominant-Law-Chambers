rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidChambersSettings(data) {
      return data.clientName is string && data.clientName.size() <= 200
          && data.firmName is string && data.firmName.size() <= 200
          && data.mobile is string && data.mobile.size() <= 50;
    }

    function isValidAuth(data) {
      return data.passwordHash is string && data.passwordHash.size() == 64;
    }

    function isValidGalleryItem(data) {
      return data.id is string && data.id.size() <= 128
          && data.url is string && data.url.size() <= 800000
          && data.title is string && data.title.size() <= 200;
    }

    // Global Chambers Settings, Auth & Branding Images
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow create, update: if isValidId(settingId) && (
        ((settingId == 'chambers_content' || settingId == 'chambers_default_checkpoint') && isValidChambersSettings(incoming())) ||
        (settingId == 'admin_auth' && isValidAuth(incoming())) ||
        (settingId == 'connection_test')
      );
      allow delete: if false;
    }

    // Global Gallery Images for Slideshow
    match /gallery_images/{imageId} {
      allow get, list: if true;
      allow create: if isValidId(imageId) && isValidGalleryItem(incoming());
      allow update: if isValidId(imageId) && isValidGalleryItem(incoming());
      allow delete: if isValidId(imageId);
    }
  }
}
